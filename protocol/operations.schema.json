{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark setup, synchronization, and monitoring observation",
  "type": "object",
  "required": ["observation_id", "system_id", "phase", "started_at", "finished_at", "status"],
  "properties": {
    "observation_id": {"type": "string"},
    "system_id": {"enum": ["da", "cc_raw", "cc_wh"]},
    "phase": {"enum": ["setup", "baseline_sync", "change_sync", "schema_change", "monitoring"]},
    "source": {"enum": ["pipedrive", "stripe", "neon", "github", "multi_source"]},
    "mutation_id": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "source_acknowledged_at": {"type": ["string", "null"], "format": "date-time"},
    "raw_ready_at": {"type": ["string", "null"], "format": "date-time"},
    "transformed_ready_at": {"type": ["string", "null"], "format": "date-time"},
    "alerted_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ok", "timeout", "error", "not_applicable"]},
    "wall_clock_ms": {"type": "integer", "minimum": 0},
    "active_human_ms": {"type": "integer", "minimum": 0},
    "records_read": {"type": "integer", "minimum": 0},
    "records_written": {"type": "integer", "minimum": 0},
    "bytes_transferred": {"type": "integer", "minimum": 0},
    "api_requests": {"type": "integer", "minimum": 0},
    "transformations_created": {"type": "integer", "minimum": 0},
    "transformations_reused": {"type": "integer", "minimum": 0},
    "identity_matches_correct": {"type": "integer", "minimum": 0},
    "identity_matches_incorrect": {"type": "integer", "minimum": 0},
    "manual_interventions": {"type": "integer", "minimum": 0},
    "scheduled_runs": {"type": "integer", "minimum": 0},
    "alerts": {"type": "integer", "minimum": 0},
    "false_positive": {"type": ["boolean", "null"]},
    "model_cost_usd": {"type": "number", "minimum": 0},
    "infra_cost_usd": {"type": "number", "minimum": 0},
    "allocated_subscription_cost_usd": {"type": "number", "minimum": 0},
    "notes": {"type": "string"}
  }
}
